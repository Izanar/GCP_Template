# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# Environment
.env
.env.*

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# State/plan backups must never be committed
*.tfstate.*
*.tfplan
.state/

# Lock files - regenerate per-project/provider on init. Never commit .terraform.lock.hcl
**/.terraform.lock.hcl
src/*/.terraform.lock.hcl
envs/*/.terraform.lock.hcl

# Terragrunt cache
.terragrunt-cache/

# Build outputs
node_modules/
dist/
build/
coverage/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Docker
*.local

# Short-lived federation credentials and local render outputs
gha-creds-*.json
terragrunt-debug.tfvars.json
terragrunt_rendered.json
*.pem

# Local tool venv
venvs/
